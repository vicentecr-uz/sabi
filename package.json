{
  "name": "sabi",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun --filter sabi-input build",
    "test": "bun run typecheck && playwright test",
    "test:watch": "SLOWMO=250 playwright test --headed --workers 1",
    "typecheck": "bun run build && tsc -p fixtures/react",
    "fixtures": "bun run build && bun fixtures/serve.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sabi-input": "workspace:*",
    "typescript": "^7.0.2"
  }
}
