---
import Docs from '../layouts/Docs.astro';
---

<Docs>
  <h1>Sabi</h1>
  <p>A text input whose overflowing edges fade, with the caret always kept in view.</p>
  <label class="field hero">
    <sabi-input>
      <span>https://</span>
      <input aria-label="URL" value="example.com/a/long/path/that/runs/past/the/edge/of/the/field" />
    </sabi-input>
  </label>
  <p><code>npm install sabi-input</code></p>
  <p><a href="/getting-started">Getting started</a></p>
</Docs>

<style>
  .hero {
    margin-block: 2em;
  }
</style>
